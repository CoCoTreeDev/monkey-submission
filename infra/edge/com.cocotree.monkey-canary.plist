<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.cocotree.monkey-canary</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-lc</string>
        <string>cd "__REPO_DIR__/backend" &amp;&amp; "__UV_BIN__" run python ../infra/canary.py</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>600</integer>
    <key>StandardOutPath</key>
    <string>__LOG_DIR__/canary.log</string>
    <key>StandardErrorPath</key>
    <string>__LOG_DIR__/canary.log</string>
</dict>
</plist>
