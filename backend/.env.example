# Database (omit to use backend/detections.db)
# DATABASE_URL=sqlite+aiosqlite:///detections.db

# Local demo defaults only. Set all three before exposing a deployment.
# Keep ADMIN_PASSWORD_SALT stable: it also hashes the persisted access codes.
ADMIN_PASSWORD_SALT=local-demo-only-change-before-deployment
SEED_ADMIN_CODE=demo-admin
SEED_USER_CODE=demo-user

# YOLO model file — the in-repo monkey detector; there is no fallback model
MODEL_PATH=best.pt

# Inference tuning
CONFIDENCE_THRESHOLD=0.5
FRAME_SKIP=5
STREAM_FPS=15
TRAIL_VIDEO_FPS=24
TRAIL_VIDEO_MAX_FRAMES=600
TRACK_MIN_HITS=3
TRACK_MIN_SECONDS=0.5

# Supply your own authorized camera sources before enabling the PoC streams.
POC_CAMERA_1_URL=
POC_CAMERA_2_URL=
# Measure existing camera FPS before enabling additional inference.
POC_EDGE_ENABLED=false
POC_FRAME_SKIP=5
POC_FRAME_QUEUE_MAX=128
POC_BATCH_ENABLED=true
POC_BATCH_MAX=2
POC_BATCH_WAIT_MS=8
POC_INFERENCE_DEVICE=cpu

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000

# Optional GitHub integration: both must be set explicitly to dispatch a job.
GITHUB_REPO=
GITHUB_DISPATCH_TOKEN=
